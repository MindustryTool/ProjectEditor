{
    "extends": "../../tsconfig.base.json",
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "src/services/validation-service.ts"
    ],
    "exclude": [
        "dist",
        ".vite",
        ".turbo",
        ".next",
        "coverage",
        "node_modules"
    ],
    "compilerOptions": {
        "target": "ES2022",
        "jsx": "react-jsx",
        "module": "ESNext",
        "paths": {
            "#/*": [
                "./src/*"
            ],
            "@/*": [
                "./src/*"
            ],
            "~/*": [
                "./src/*"
            ]
        },
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "types": [
            "vite/client"
        ],
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "noUncheckedSideEffectImports": true
    }
}
